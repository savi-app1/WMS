# ============================================================
# WMS — Variables d'environnement (exemple)
# Copier vers .env puis renseigner les valeurs réelles.
# Ne JAMAIS versionner le fichier .env réel.
# ============================================================

# --- Application ---
NODE_ENV=production
PORT=3000
# URL publique de l'application (utilisée pour les liens partagés / WhatsApp)
PUBLIC_URL=https://wms.example.com
# Secret de session (>= 32 caractères aléatoires). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# --- Base de données ---
DATABASE_PATH=data/wms.sqlite

# --- Administration (compte unique, pas d'inscription publique) ---
ADMIN_EMAIL=admin@wms.bf
# Mot de passe initial (haché avec scrypt au premier démarrage).
# Changer immédiatement après la première connexion via Administration > Paramètres.
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# --- Contact & WhatsApp ---
# Numéro WhatsApp d'information WMS (format international sans +)
WHATSAPP_NUMBER=22656592557
# Numéro visible sur le site
CONTACT_PHONE=+226 56 59 25 57
CONTACT_PHONE_ALT=+226 79 00 13 17

# --- Livraison ---
# Frais de livraison par zone en FCFA (JSON). Laisser {} pour « tarifs à confirmer ».
DELIVERY_ZONES={}

# --- Analytics (optionnel) ---
# Identifiant Google Analytics 4 (ex: G-XXXXXXXXXX). Laisser vide = analytics internes uniquement.
GA4_MEASUREMENT_ID=
