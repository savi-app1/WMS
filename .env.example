# ---------------------------------------------------------------------------
# WMS — variables d'environnement
# Copiez ce fichier vers `.env` (développement) ou `.env.production` (production)
# et renseignez les valeurs. Ne versionnez jamais le fichier `.env` réel.
# ---------------------------------------------------------------------------

# URL publique du site (sans slash final). Utilisée pour les liens de partage,
# les UTM, les balises SEO et le suivi de commande.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Administrateur unique (créé par `npm run migrate`)
# Mot de passe de 12 caractères minimum, à conserver en lieu sûr.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@wendmanegda.com
ADMIN_PASSWORD=changez-moi-avec-un-long-mot-de-passe
ADMIN_NAME=Administrateur WMS

# ---------------------------------------------------------------------------
# Coordination client
# ---------------------------------------------------------------------------
# Numéro WhatsApp au format international, chiffres uniquement (sans « + »).
NEXT_PUBLIC_WHATSAPP_NUMBER=22656592557
NEXT_PUBLIC_CONTACT_PHONE_PRIMARY=+226 56 59 25 57
NEXT_PUBLIC_CONTACT_PHONE_SECONDARY=+226 79 00 13 17
NEXT_PUBLIC_CONTACT_EMAIL=contact@wendmanegda.com

# Durée de validité d'une session d'administration (heures).
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Mesure d'audience (optionnel)
# Renseignez l'identifiant GA4 pour activer Google Analytics 4 en complément
# de la mesure « first-party » déjà incluse. Laissez vide pour ne pas l'activer.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Données d'exécution
# Emplacement de la base SQLite et des médias uploadés (défaut : ./data).
# Sur un hébergement à disque éphémère, montez un volume persistant ici.
# ---------------------------------------------------------------------------
WMS_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Déploiement (facultatif, selon l'hébergeur)
# ---------------------------------------------------------------------------
NODE_ENV=production
