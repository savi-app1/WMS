{
  "name": "wms",
  "version": "1.0.0",
  "private": true,
  "description": "Wendmanegda Multiples Services (WMS) — boutique en ligne et administration des commandes",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "npm run migrate && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "brand": "tsx scripts/prepare-brand-assets.ts",
    "env": "node scripts/generate-env.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sharp": "0.35.5",
    "zod": "3.24.1"
  },
  "overrides": {
    "postcss": "8.4.49"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "9.20.1",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
