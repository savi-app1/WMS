<%- include('_head', { title, config }) %>
<main class="login-box">
  <div class="login-logo">
    <img src="/static/img/wms-logo.jpeg" alt="WMS">
    <div style="font-weight:800;font-size:16px">Wendmanegda Multiples Services</div>
    <div class="muted">Espace privé — administration</div>
  </div>
  <div class="panel">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <div class="form-row">
        <label for="email">Adresse e-mail</label>
        <input type="email" id="email" name="email" required autocomplete="username" maxlength="120">
      </div>
      <div class="form-row">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <input type="hidden" name="next" value="<%= next %>">
      <button type="submit" class="btn btn-red btn-block">Se connecter</button>
      <p class="muted" style="margin:12px 0 0;text-align:center">Les tentatives de connexion sont limitées et enregistrées à des fins de sécurité.</p>
    </form>
  </div>
  <p class="footer-admin">Accès réservé à l'administrateur WMS.</p>
</main>
</body>
</html>
