<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Accueil WMS">
      <img src="/static/img/wms-logo.jpeg" alt="Logo WMS — Wendmanegda Multiples Services" width="46" height="46">
      <span class="brand-text">
        <span class="brand-name">Wendmanegda Multiples Services</span>
        <span class="brand-slogan">Engagés pour satisfaire, motivés pour faire grandir.</span>
      </span>
    </a>
    <button class="burger" id="navToggle" aria-label="Ouvrir le menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Navigation principale">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Accueil</a>
      <a href="/produits" class="<%= currentPath.startsWith('/produits') || currentPath.startsWith('/produit') ? 'active' : '' %>">Produits</a>
      <a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>">Services</a>
      <a href="/suivi" class="<%= currentPath.startsWith('/suivi') ? 'active' : '' %> nav-track">Suivre ma commande</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>
  </div>
</header>
<script nonce="<%= nonce %>">
  (function () {
    var t = document.getElementById('navToggle');
    var n = document.getElementById('mainNav');
    if (t && n) t.addEventListener('click', function () {
      var open = n.classList.toggle('open');
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>
