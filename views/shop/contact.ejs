<%- include('_head', { title, meta, nonce, config, currentPath, year }) %>
<%- include('_header', { currentPath, nonce, config }) %>

<main class="container" style="max-width:760px;padding:30px 16px">
  <nav class="breadcrumb"><a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>Contact</span></nav>

  <div class="panel" style="margin-top:16px">
    <h1 style="font-size:22px;margin:0 0 10px">Contactez WMS</h1>
    <p class="muted" style="margin:0 0 14px">Wendmanegda Multiples Services — Ouagadougou, Burkina Faso.<br>« Engagés pour satisfaire, motivés pour faire grandir. »</p>

    <div style="display:grid;gap:12px">
      <a class="btn btn-green btn-block" href="<%= waLink %>" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.5.8 4.9 2.2 6.8L4.5 26.5l4.9-1.6c1.8 1 3.9 1.6 6 1.6 6.6 0 12.6-5 12.6-11.5S22.6 3 16 3zm5.2 15.8c-.3-.1-1.7-.8-2-1-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1.1-.1.2-.3.2-.5.1-1.3-.6-2.2-1.3-3-2.3-.3-.4-.8-1-.9-1.3-.1-.3 0-.4.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 2.6 1.2 3.2 1 3.8.9.6 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3z"/></svg>
        WhatsApp : <%= config.contactPhone %>
      </a>
      <a class="btn btn-ghost btn-block" href="tel:+22656592557">Appeler : <%= config.contactPhone %></a>
      <a class="btn btn-ghost btn-block" href="tel:+22679001317">Appeler : <%= config.contactPhoneAlt %></a>
    </div>
  </div>

  <div class="panel">
    <h3 style="margin:0 0 10px">Livraison &amp; précautions</h3>
    <ul style="margin:0;padding-left:19px;font-size:14.5px;display:grid;gap:7px">
      <li>Livraison rapide à <strong>Ouagadougou et environs</strong>.</li>
      <li><strong>Paiement à la livraison</strong> : vous payez à la réception de votre produit.</li>
      <li>Frais de livraison selon votre zone, confirmés par téléphone.</li>
      <li>Suivi de commande disponible sur la page <a href="/suivi">Suivi</a>.</li>
    </ul>
  </div>

  <div class="panel">
    <h3 style="margin:0 0 10px">Services digitaux</h3>
    <p class="muted" style="margin:0 0 10px">Créations graphiques, accompagnement e-commerce, gestion de pages, campagnes publicitaires et formations WMS Academy.</p>
    <a class="btn btn-dark btn-block" href="/services">Découvrir les services</a>
  </div>
</main>

<%- include('_footer', { config, year, nonce, currentPath }) %>
