<%- include('_head', { title, meta, nonce, config, currentPath, year }) %>
<%- include('_header', { currentPath, nonce, config }) %>

<main>
  <!-- Héros -->
  <section class="hero">
    <div class="inner">
      <div>
        <span class="hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 7.1-1.01z"/></svg>
          Ouagadougou · Burkina Faso
        </span>
        <h1>Wendmanegda <span>Multiples Services</span></h1>
        <p class="lead">« Engagés pour satisfaire, motivés pour faire grandir. » Smartphones, accessoires, électroménager, produits numériques, formations et services digitaux. Livraison rapide à Ouagadougou et environs, paiement à la livraison.</p>
        <div class="hero-actions">
          <a class="btn btn-red" href="/produits">Découvrir le catalogue</a>
          <a class="btn btn-green" href="https://wa.me/<%= config.whatsappNumber %>?text=<%= encodeURIComponent('Bonjour WMS, je souhaite commander.') %>" target="_blank" rel="noopener" data-track="whatsapp_click" data-detail="hero">Commander sur WhatsApp</a>
        </div>
      </div>
      <figure>
        <img class="hero-banner-img" src="/static/img/wms-banner.jpeg" alt="Wendmanegda Multiples Services (WMS) — produits et services à Ouagadougou" loading="eager">
      </figure>
    </div>
    <div class="hero-trust">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="#25d366" stroke-width="1.8" aria-hidden="true"><path d="M3 5h13v10H3zM16 8h4l1 3v4h-5zM7.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM18.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg>
        Livraison rapide<br>à Ouagadougou
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffd166" stroke-width="1.8" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        Paiement à la livraison<br>et Mobile Money
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="#98c1ff" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 11-9-9"/><path d="M21 3l-9 9"/><path d="M15 3h6v6"/></svg>
        Commande simple<br>sans création de compte
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ff9aa2" stroke-width="1.8" aria-hidden="true"><path d="M4 17l6-6 6 6 4-4"/><path d="M20 9h-4V5"/></svg>
        Formations WMS Academy<br>&amp; services digitaux
      </div>
    </div>
  </section>

  <!-- Recherche -->
  <section class="section">
    <div class="container">
      <form class="searchbar" action="/produits" method="get" role="search">
        <input type="search" name="q" placeholder="Rechercher un produit ou un service…" aria-label="Rechercher un produit">
        <button type="submit">Rechercher</button>
      </form>
    </div>
  </section>

  <!-- Catégories -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Catégories</h2>
        <a class="more" href="/produits">Tout voir →</a>
      </div>
      <div class="cat-grid">
        <% categories.slice(0, 10).forEach(function (c) { %>
          <a class="cat-card" href="/produits?categorie=<%= encodeURIComponent(c.slug) %>">
            <span class="dot">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
            </span>
            <span><%= c.name %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Produits en vedette -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Produits &amp; services</h2>
        <a class="more" href="/produits">Tout voir →</a>
      </div>
      <% if (products.length === 0) { %>
        <div class="empty-state">
          <div class="big">Catalogue en préparation</div>
          <p>Les produits et prix sont en cours de mise à jour par notre équipe.<br>
          Contactez-nous sur <a href="https://wa.me/<%= config.whatsappNumber %>" target="_blank" rel="noopener">WhatsApp</a> pour toute demande ou prix.</p>
          <a class="btn btn-red" href="https://wa.me/<%= config.whatsappNumber %>?text=<%= encodeURIComponent('Bonjour WMS, je souhaite connaître vos produits disponibles.') %>" target="_blank" rel="noopener">Demander le catalogue sur WhatsApp</a>
        </div>
      <% } else { %>
        <div class="grid">
          <% products.forEach(function (p) { %>
            <%- include('_product-card', { p, formatFcfa }) %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Services WMS -->
  <section class="section">
    <div class="container">
      <div class="section-title">
        <h2>Les services WMS</h2>
        <a class="more" href="/services">Détails →</a>
      </div>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
        <div class="card" style="padding:18px">
          <h3 style="margin:0 0 6px">Créations graphiques</h3>
          <p class="muted" style="margin:0">Logos, affiches, flyers, contenus publicitaires professionnels pour votre marque et vos campagnes.</p>
        </div>
        <div class="card" style="padding:18px">
          <h3 style="margin:0 0 6px">Accompagnement e-commerce</h3>
          <p class="muted" style="margin:0">Conseils, gestion de pages, campagnes publicitaires ciblées et suivi de performance.</p>
        </div>
        <div class="card" style="padding:18px">
          <h3 style="margin:0 0 6px">Formations WMS Academy</h3>
          <p class="muted" style="margin:0">Formations en ligne et à distance : e-commerce, marketing digital, vente en ligne.</p>
        </div>
        <div class="card" style="padding:18px">
          <h3 style="margin:0 0 6px">Produits numériques</h3>
          <p class="muted" style="margin:0">Livres PDF, ebooks, guides pratiques et contenus audiovisuels.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('_footer', { config, year, nonce, currentPath }) %>
